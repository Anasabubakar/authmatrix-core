{
  "name": "@anas.abubakar/authmatrix-core",
  "version": "0.1.1",
  "description": "Language-neutral Soroban authorization vectors, two independent adapters (TypeScript SDK and Rust stellar-xdr), and host-backed verification evidence.",
  "license": "MIT",
  "author": "Anas Abubakar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/vector.v1.schema.json": "./schema/vector.v1.schema.json",
    "./schema/adapter-protocol.v1.schema.json": "./schema/adapter-protocol.v1.schema.json",
    "./schema/evidence.v1.schema.json": "./schema/evidence.v1.schema.json",
    "./vectors/authmatrix-vectors.v1.json": "./vectors/authmatrix-vectors.v1.json",
    "./vectors/rfc8032-ed25519.json": "./vectors/rfc8032-ed25519.json",
    "./evidence/native-host/results.json": "./evidence/native-host/results.json",
    "./evidence/testnet/summary.json": "./evidence/testnet/summary.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "evidence/native-host/results.json",
    "evidence/testnet/summary.json",
    "evidence/testnet/deployment.json",
    "evidence/conformance-report.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema": "node --experimental-strip-types scripts/gen-schema.ts",
    "check:schema": "node --experimental-strip-types scripts/gen-schema.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "evidence:native": "bash scripts/record-native.sh",
    "evidence:testnet": "node --experimental-strip-types --no-warnings scripts/testnet-evidence.ts",
    "conformance": "node --experimental-strip-types scripts/conformance.ts",
    "vectors": "node --experimental-strip-types scripts/gen-vectors.ts",
    "check:vectors": "node --experimental-strip-types scripts/gen-vectors.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anasabubakar/authmatrix-core.git"
  },
  "homepage": "https://github.com/Anasabubakar/authmatrix-core#readme",
  "bugs": {
    "url": "https://github.com/Anasabubakar/authmatrix-core/issues"
  }
}
