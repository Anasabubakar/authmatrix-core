{
  "title": "AuthMatrix vector file v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "authmatrix-vectors"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generator": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sdk": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "sdk",
        "note"
      ]
    },
    "vectors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signer": {
            "type": "object",
            "properties": {
              "publicKey": {
                "type": "string",
                "pattern": "^G[A-Z2-7]{55}$"
              },
              "derivation": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "const": "sha256-of-utf8-phrase"
                  },
                  "phrase": {
                    "type": "string",
                    "minLength": 8
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "scheme",
                  "phrase",
                  "note"
                ]
              }
            },
            "required": [
              "publicKey",
              "derivation"
            ]
          },
          "authorization": {
            "type": "object",
            "properties": {
              "networkPassphrase": {
                "type": "string",
                "minLength": 1
              },
              "credentialType": {
                "type": "string",
                "enum": [
                  "address",
                  "addressV2"
                ],
                "description": "address = SOROBAN_CREDENTIALS_ADDRESS (legacy payload, not address-bound); addressV2 = SOROBAN_CREDENTIALS_ADDRESS_V2 (CAP-71, address-bound payload)"
              },
              "address": {
                "type": "string",
                "pattern": "^G[A-Z2-7]{55}$",
                "description": "the authorizing address; must equal the signer public key"
              },
              "nonce": {
                "type": "string",
                "pattern": "^-?\\d{1,19}$"
              },
              "signatureExpirationLedger": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "rootInvocation": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "networkPassphrase",
              "credentialType",
              "address",
              "nonce",
              "signatureExpirationLedger",
              "rootInvocation"
            ]
          },
          "expected": {
            "type": "object",
            "properties": {
              "preimageType": {
                "type": "string",
                "enum": [
                  "envelopeTypeSorobanAuthorization",
                  "envelopeTypeSorobanAuthorizationWithAddress"
                ]
              },
              "preimageXdr": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "payloadHashHex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "sha256 over the preimage XDR bytes"
              },
              "signatureHex": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              },
              "unsignedEntryXdr": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "signedEntryXdr": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              }
            },
            "required": [
              "preimageType",
              "preimageXdr",
              "payloadHashHex",
              "signatureHex",
              "unsignedEntryXdr",
              "signedEntryXdr"
            ]
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "description": "inclusive protocol range in which this credential type is expected to be accepted; max null = no known upper bound"
              },
              "status": {
                "type": "string",
                "enum": [
                  "current",
                  "legacy-still-valid",
                  "historical-unverified"
                ]
              },
              "note": {
                "type": "string"
              },
              "hostVerified": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "environment": {
                      "type": "string",
                      "enum": [
                        "native-testutils",
                        "testnet-simulate-enforce"
                      ]
                    },
                    "protocolVersion": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "evidence": {
                      "type": "string",
                      "description": "repo-relative path of the recorded output"
                    },
                    "original": {
                      "type": "string",
                      "enum": [
                        "accepted"
                      ]
                    },
                    "mutationsRejected": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "recipient",
                          "amount",
                          "network",
                          "nonce",
                          "expiry",
                          "function",
                          "contractId"
                        ]
                      }
                    }
                  },
                  "required": [
                    "environment",
                    "evidence",
                    "original",
                    "mutationsRejected"
                  ]
                }
              }
            },
            "required": [
              "protocol",
              "status",
              "note",
              "hostVerified"
            ]
          },
          "mutations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "field": {
                  "type": "string",
                  "enum": [
                    "recipient",
                    "amount",
                    "network",
                    "nonce",
                    "expiry",
                    "function",
                    "contractId"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "changedPaths": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "paths into `authorization` that differ from the original"
                },
                "mutatedAuthorization": {
                  "type": "object",
                  "properties": {
                    "networkPassphrase": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credentialType": {
                      "type": "string",
                      "enum": [
                        "address",
                        "addressV2"
                      ],
                      "description": "address = SOROBAN_CREDENTIALS_ADDRESS (legacy payload, not address-bound); addressV2 = SOROBAN_CREDENTIALS_ADDRESS_V2 (CAP-71, address-bound payload)"
                    },
                    "address": {
                      "type": "string",
                      "pattern": "^G[A-Z2-7]{55}$",
                      "description": "the authorizing address; must equal the signer public key"
                    },
                    "nonce": {
                      "type": "string",
                      "pattern": "^-?\\d{1,19}$"
                    },
                    "signatureExpirationLedger": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "rootInvocation": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": [
                    "networkPassphrase",
                    "credentialType",
                    "address",
                    "nonce",
                    "signatureExpirationLedger",
                    "rootInvocation"
                  ]
                },
                "expected": {
                  "type": "object",
                  "properties": {
                    "payloadHashChanged": {
                      "type": "boolean",
                      "const": true
                    },
                    "mutatedPreimageXdr": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                    },
                    "mutatedPayloadHashHex": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "originalSignatureVerifies": {
                      "type": "boolean",
                      "const": false
                    },
                    "entryXdrWithOriginalSignature": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                      "description": "mutated entry carrying the ORIGINAL signature and the mutated expiry"
                    },
                    "hostExpectation": {
                      "type": "string",
                      "const": "reject",
                      "description": "a conforming host must refuse to authorize this entry"
                    },
                    "resignedEntryXdr": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                      "description": "positive control: the SAME mutated authorization freshly signed by the signer; a host must ACCEPT it, which shows the original-signature rejection is about the signature and not about a malformed call"
                    },
                    "resignedSignatureHex": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{128}$"
                    }
                  },
                  "required": [
                    "payloadHashChanged",
                    "mutatedPreimageXdr",
                    "mutatedPayloadHashHex",
                    "originalSignatureVerifies",
                    "entryXdrWithOriginalSignature",
                    "hostExpectation",
                    "resignedEntryXdr",
                    "resignedSignatureHex"
                  ]
                }
              },
              "required": [
                "id",
                "field",
                "description",
                "changedPaths",
                "mutatedAuthorization",
                "expected"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "labels",
          "signer",
          "authorization",
          "expected",
          "compatibility",
          "mutations"
        ]
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "generator",
    "vectors"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^C[A-Z2-7]{55}$"
        },
        "functionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "description": "each element is one ScVal serialized as XDR then base64"
        },
        "subInvocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "contractId",
        "functionName",
        "args",
        "subInvocations"
      ]
    }
  }
}
